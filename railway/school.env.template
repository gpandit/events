# One line per variable: KEY=VALUE. {{NAME}} is replaced by new-school.sh.
# ${{Postgres.X}} / ${{Redis.X}} are Railway reference variables and are left as-is.
# Secrets are NOT stored here: pass them as exported environment variables (see docs).

# Core
APP_ENV=production
APP_DEBUG=false
APP_NAME={{SCHOOL_NAME}}
APP_URL=https://{{DOMAIN}}
APP_FRONTEND_URL=https://{{DOMAIN}}
APP_CDN_URL=https://{{DOMAIN}}/storage
APP_DISABLE_REGISTRATION=true
APP_SAAS_MODE_ENABLED=false
APP_PLATFORM_SUPPORT_EMAIL={{SUPPORT_EMAIL}}
LOG_CHANNEL=stderr
QUEUE_CONNECTION=redis
CACHE_DRIVER=redis
SESSION_DRIVER=redis

# Database and cache (created by the Postgres and Redis services in this environment)
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
REDIS_HOST=${{Redis.REDISHOST}}
REDIS_PORT=${{Redis.REDISPORT}}
REDIS_PASSWORD=${{Redis.REDISPASSWORD}}

# Mail
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS={{MAIL_FROM_ADDRESS}}
MAIL_FROM_NAME={{SCHOOL_NAME}}

# Site contact routing (footer form, volunteer sign-ups, erasure receipts)
SITE_CONTACT_EMAIL={{SITE_CONTACT_EMAIL}}
SITE_CONTACT_CC_EMAIL={{SITE_CONTACT_CC_EMAIL}}
SITE_CONTACT_SUBJECT_TAG={{SCHOOL_NAME}}

# Frontend (VITE_* are read at build/start)
VITE_APP_NAME={{SCHOOL_NAME}}
VITE_FRONTEND_URL=https://{{DOMAIN}}
VITE_API_URL_CLIENT=https://{{DOMAIN}}/api
VITE_API_URL_SERVER=http://localhost:80/api
VITE_DEFAULT_SHARE_IMAGE_PATH={{SHARE_IMAGE_PATH}}
VITE_INSTAGRAM_HANDLE={{INSTAGRAM_HANDLE}}
VITE_GOOGLE_TAG_ID={{GOOGLE_TAG_ID}}
VITE_COOKIE_CONSENT_ENABLED=true
VITE_DEFAULT_ORGANIZER_ID={{DEFAULT_ORGANIZER_ID}}
